<services>
  <service name="tar_scm">
    <param name="scm">git</param>
    <param name="url">https://github.com/hawkeye116477/waterfox-deb-rpm-arch-AppImage.git</param>
    <param name="filename">debian</param>
    <param name="subdir">waterfox-classic-kpe</param>
    <param name="version">_none_</param>
  </service>
  <service name="recompress">
    <param name="file">*debian*.tar</param>
    <param name="compression">xz</param>
  </service>
  <service name="extract_file">
    <param name="archive">*debian*.tar.xz</param>
    <param name="files">*/waterfox-classic-kpe.dsc */patches/*.patch */vendor.js */waterfox-classic.desktop */waterfox-classic.1 */syspref.js */kde.js */distribution.ini */waterfox-classic.appdata.xml.in</param>
  </service>
</services>